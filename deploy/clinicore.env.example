# Configuration for everything in deploy/. Copy to /etc/clinicore/clinicore.env
# and edit. This file holds no secrets — the age *public* key is safe to store
# on the box, which is the whole point of using a keypair (see backup.sh).
#
#   sudo mkdir -p /etc/clinicore
#   sudo cp deploy/clinicore.env.example /etc/clinicore/clinicore.env
#   sudo nano /etc/clinicore/clinicore.env

# Where the checkout with docker-compose.prod.yml lives.
CLINICORE_DIR=/opt/clinicore

# Compose project name. Must match `name:` in docker-compose.prod.yml, because
# the media volume is addressed as <project>_media_data.
COMPOSE_PROJECT=clinicore-prod

# Where encrypted backups are written on this box. Off-box copies go to Drive;
# this is the working set the rotation applies to.
BACKUP_DIR=/var/backups/clinicore

# Written by the scripts, read by the app (mounted read-only into the web
# container). This is how a backup that stopped running becomes visible to an
# administrator instead of failing silently. Must match the bind mount in
# docker-compose.prod.yml.
STATUS_DIR=/opt/clinicore/run

# The age PUBLIC key backups are encrypted to. Generate the pair OFF this box:
#
#   age-keygen -o clinicore-backup.key
#
# The output file's "Public key: age1..." line goes here. The file itself is
# the private key and must NEVER be on this server — see docs/RUNBOOK.md.
AGE_RECIPIENT=

# rclone remote for the off-box copy, as <remote>:<path>. Configure the remote
# with `rclone config` as the user the timers run as. Leave empty to skip the
# upload (local-only backups protect against almost nothing — set it).
RCLONE_REMOTE=gdrive:clinicore-backups

# Rotation. Daily backups are kept for KEEP_DAILY days; a copy taken on the
# first of each month is kept for KEEP_MONTHLY months.
KEEP_DAILY=30
KEEP_MONTHLY=12
