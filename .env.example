# Clinicore configuration. Copy to `.env` and edit; `.env` is gitignored and
# must never be committed — it holds a real SECRET_KEY and database password.
#
#   cp .env.example .env
#
# Everything here is read by config/settings.py through os.environ. There is no
# base/dev/prod settings split because there is nothing left to split: the two
# deployments differ by this file.

# --- Core ------------------------------------------------------------------

# Off unless explicitly on. Leaving it unset is the safe direction: a
# development machine that forgets it looks broken and gets fixed in seconds,
# while a deployment that forgets it serves tracebacks and settings to the
# internet quietly. Never `true` on a server.
DJANGO_DEBUG=false

# Required whenever DJANGO_DEBUG is off — the app raises ImproperlyConfigured
# on boot rather than falling back to the development key, which is committed
# to this public repository. Generate one with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
DJANGO_SECRET_KEY=

# Comma-separated. Include the hostname the clinic actually types, plus
# localhost — the container healthcheck requests http://localhost:8000/healthz
# from inside the container and Django matches Host against this list before
# any view runs, so omitting it reports a healthy app as permanently unhealthy.
DJANGO_ALLOWED_HOSTS=clinic.example.com,localhost,127.0.0.1

# Comma-separated, and each needs its scheme. Django checks the Origin header
# on every POST against this list, so an omission here looks like every form in
# the app failing CSRF at once.
DJANGO_CSRF_TRUSTED_ORIGINS=https://clinic.example.com

# --- Database --------------------------------------------------------------
#
# Setting POSTGRES_DB is what switches config/settings.py off SQLite. Leave the
# whole block unset for a local SQLite run.

POSTGRES_DB=clinicore
POSTGRES_USER=clinicore
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- HTTPS and the reverse proxy -------------------------------------------

# Set only when a proxy you control terminates TLS and sets X-Forwarded-Proto
# itself. It must stay off otherwise: the header is client-supplied like any
# other, so trusting it while nothing upstream overwrites it lets anyone send
# `X-Forwarded-Proto: https` over plain HTTP and have Django agree. Turning it
# on also tells django-axes to read the client IP from X-Forwarded-For, without
# which every login attempt appears to come from the proxy.
DJANGO_BEHIND_PROXY=true

# Number of proxies between the client and the app, for client-IP resolution.
DJANGO_PROXY_COUNT=1

# Defaults to DJANGO_BEHIND_PROXY. The healthcheck path is exempt so the
# container's plain-HTTP probe is not redirected to a scheme it cannot follow.
DJANGO_SSL_REDIRECT=true

# Secure flag on the session and CSRF cookies. Defaults to "not DEBUG"; set it
# false only if you are genuinely serving over plain HTTP.
DJANGO_SECURE_COOKIES=true

# HSTS, in seconds. Off (0) by default and deliberately opt-in: browsers cache
# the policy for the full duration, so enabling it before certificates renew
# reliably makes the site unreachable rather than insecure. 31536000 is a year;
# start with something like 3600 and raise it once renewal has been proven.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# --- Login rate limiting (django-axes) -------------------------------------

# Failed attempts allowed for one phone number from one address before a pause.
# Locking is on the pair: a clinic is one public IP, so locking on address
# alone would let anyone who can reach the login page shut the whole practice
# out of its own records.
DJANGO_AXES_FAILURE_LIMIT=5

# How long the pause lasts. It expires on its own — reception has nobody on
# site to unlock an account.
DJANGO_AXES_COOLOFF_MINUTES=15

# --- Logging ---------------------------------------------------------------

# Root log level. DEBUG is safe to raise temporarily: SQL logging is pinned at
# INFO separately, because queries carry patient data.
DJANGO_LOG_LEVEL=INFO

# --- Production compose only -----------------------------------------------
# Read by docker-compose.prod.yml, not by Django.

# Host port the app is published on. Put a TLS-terminating proxy in front.
WEB_PORT=8000

# Gunicorn worker count. A small clinic is fine on 3; the usual starting point
# is (2 * CPU cores) + 1.
GUNICORN_WORKERS=3
